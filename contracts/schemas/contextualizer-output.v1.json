{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firewatch.local/contracts/contextualizer-output.v1.json",
  "title": "Contextualizer output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "claims"],
  "properties": {
    "schema_version": { "const": "contextualizer-output.v1" },
    "summary": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "evidence_refs"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "text": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
