{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firewatch.local/contracts/validator-output.v1.json",
  "title": "Validator output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "issues"],
  "properties": {
    "schema_version": { "const": "validator-output.v1" },
    "decision": { "enum": ["approved", "revision_requested"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_code", "claim_id", "evidence_refs"],
        "properties": {
          "issue_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          "claim_id": { "type": ["string", "null"] },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
