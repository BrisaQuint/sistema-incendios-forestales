          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coverage": {
      "get": {
        "summary": "Get Coverage",
        "operationId": "get_coverage_api_coverage_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoverageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/coverage/province": {
      "get": {
        "summary": "Get Province Boundary",
        "operationId": "get_province_boundary_api_coverage_province_get",
