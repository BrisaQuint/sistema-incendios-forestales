{
  "openapi": "3.1.0",
  "info": {
    "title": "FireWatch API",
    "description": "Local API and typed contracts for the FireWatch analysis runtime.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health/ready": {
      "get": {
        "summary": "Readiness",
        "operationId": "readiness_api_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          },
          "snapshot_version": {
            "title": "Snapshot Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "snapshot_version"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "Coordinates": {
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Coordinates",
        "type": "object"
      },
      "CoverageFeature": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "Feature",
            "title": "Type",
            "type": "string"
          },
          "geometry": {
            "discriminator": {
              "mapping": {
                "MultiPolygon": "#/components/schemas/MultiPolygonGeometry",
                "Polygon": "#/components/schemas/PolygonGeometry"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/PolygonGeometry"
              },
              {
                "$ref": "#/components/schemas/MultiPolygonGeometry"
              }
            ],
            "title": "Geometry"
          },
          "properties": {
            "$ref": "#/components/schemas/CoverageProperties"
          }
        },
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "title": "CoverageFeature",
        "type": "object"
      },
      "CoverageProperties": {
        "additionalProperties": false,
        "properties": {
          "weather_id": {
            "minLength": 1,
            "title": "Weather Id",
            "type": "string"
          },
          "center": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "center_inside": {
            "title": "Center Inside",
            "type": "boolean"
          },
          "intersects": {
            "title": "Intersects",
            "type": "boolean"
          },
          "available_dates": {
            "items": {
              "format": "date",
              "type": "string"
            },
            "title": "Available Dates",
            "type": "array"
          }
        },
        "required": [
          "weather_id",
          "center",
          "center_inside",
          "intersects",
          "available_dates"
        ],
        "title": "CoverageProperties",
        "type": "object"
      },
      "MultiPolygonGeometry": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "MultiPolygon",
            "title": "Type",
            "type": "string"
          },
          "coordinates": {
            "items": {
              "items": {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            },
            "title": "Coordinates",
            "type": "array"
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "title": "MultiPolygonGeometry",
        "type": "object"
      },
      "PolygonGeometry": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "Polygon",
            "title": "Type",
            "type": "string"
          },
          "coordinates": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "title": "Coordinates",
            "type": "array"
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "title": "PolygonGeometry",
        "type": "object"
      },
      "CoverageResponse": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "FeatureCollection",
            "title": "Type",
            "type": "string"
          },
          "snapshot_version": {
            "title": "Snapshot Version",
            "type": "string"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/CoverageFeature"
            },
            "title": "Features",
            "type": "array"
          }
        },
        "required": [
          "type",
          "snapshot_version",
          "features"
        ],
        "title": "CoverageResponse",
        "type": "object"
      },
      "AnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "weather_id": {
            "minLength": 1,
            "title": "Weather Id",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          }
        },
        "required": [
          "weather_id",
          "date"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "DataValue": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "missing_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Missing Reason"
          }
        },
        "required": [
          "value",
          "unit",
          "missing_reason"
        ],
        "title": "DataValue",
        "type": "object"
      },
      "AnalysisResult": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "format": "uuid",
            "title": "Analysis Id",
            "type": "string"
          },
          "weather_id": {
            "title": "Weather Id",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "completed",
              "partial",
              "failed"
            ],
            "title": "State",
            "type": "string"
          },
          "fwi": {
            "$ref": "#/components/schemas/DataValue"
          },
          "historical_reference_fwi": {
            "$ref": "#/components/schemas/DataValue"
          },
          "difference_from_reference": {
            "$ref": "#/components/schemas/DataValue"
          }
        },
        "required": [
          "analysis_id",
          "weather_id",
          "date",
          "state",
          "fwi",
          "historical_reference_fwi",
          "difference_from_reference"
        ],
        "title": "AnalysisResult",
        "type": "object"
      },
      "APIError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "APIError",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/APIError"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "analysis_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Id"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "TraceEvent": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "trace-event.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "analysis_id": {
            "format": "uuid",
            "title": "Analysis Id",
            "type": "string"
          },
          "sequence": {
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          },
          "event_type": {
            "enum": [
              "run_queued",
              "run_started",
              "analysis_core_result_persisted",
              "tool_failed",
              "intervention_started",
              "intervention_completed",
              "intervention_failed",
              "review_approved",
              "review_revision_requested",
              "run_interrupted",
              "run_completed",
              "run_partial",
              "run_failed"
            ],
            "title": "Event Type",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "idempotency_key": {
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "intervention_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Intervention Id"
          },
          "agent_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Agent Role"
          },
          "task": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Task"
          },
          "input_evidence_refs": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Input Evidence Refs"
          },
          "result_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Summary"
          },
          "output_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Output Ref"
          },
          "evidence_refs": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evidence Refs"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tool Name"
          },
          "decision": {
            "anyOf": [
              {
                "enum": [
                  "approved",
                  "revision_requested"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Decision"
          },
          "issue_refs": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Issue Refs"
          },
          "result_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Ref"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Code"
          },
          "affected_outputs": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Affected Outputs"
          }
        },
        "required": [
          "schema_version",
          "analysis_id",
          "sequence",
          "event_type",
          "occurred_at",
          "idempotency_key"
        ],
        "title": "TraceEvent",
        "type": "object"
      }
    }
  }
}
